    <description>Creates a Gift Voucher for each selected Account. Screen 1: offer type (Fixed Price or Percentage) with minimum and maximum bill amount. Screen 2: filter Accounts with dynamic rules and select them. Screen 3: voucher code prefix (pre-filled, editable), expiry date and issued by. On Save every selected Account gets one Active Gift Voucher with its own unique code (prefix-XXXX). All three screens use the dynamicFieldSelection LWC. Launched from the New list button on Gift Voucher.</description>
    <environments>Default</environments>
    <formulas>
        <name>Discount_Percentage_Value</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!Discount_Percentage}), 0, VALUE({!Discount_Percentage}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Maximum_Amount_Value</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Max_Amount}), 0, VALUE({!Max_Amount}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Blank minimum means 0.</description>
        <name>Minimum_Amount_Value</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Min_Amount}), 0, VALUE({!Min_Amount}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Offer_Amount_Value</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Offer_Amount}), 0, VALUE({!Offer_Amount}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Readable summary of the offer for the success screen.</description>
        <name>Offer_Summary</name>
        <dataType>String</dataType>
        <expression>IF(
  {!Offer_Type} = &quot;Fixed Price&quot;,
  &quot;₹&quot; &amp; TEXT({!Offer_Amount_Value}) &amp; &quot; off&quot;,
  TEXT({!Discount_Percentage_Value}) &amp; &quot;% off&quot;
) &amp; &quot; on bills from ₹&quot; &amp; TEXT({!Minimum_Amount_Value}) &amp; &quot; to ₹&quot; &amp; TEXT({!Maximum_Amount_Value})</expression>
    </formulas>
