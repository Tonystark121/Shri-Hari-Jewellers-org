            <fieldText>Redemption at POS</fieldText>
            <fieldType>RegionContainer</fieldType>
            <fields>
                <name>Redemption_Section_Column1</name>
                <fieldType>Region</fieldType>
                <fields>
                    <name>Redemption_Intro</name>
                    <fieldText>&lt;p&gt;&lt;span style="color: rgb(112, 110, 107);"&gt;Record what was redeemed at the POS. Salesforce deducts the points from the customer&amp;apos;s balance and marks the voucher Redeemed; nothing is decided here.&lt;/span&gt;&lt;/p&gt;</fieldText>
                    <fieldType>DisplayText</fieldType>
                </fields>
                <fields>
                    <name>Points_Redeemed_Input</name>
                    <dataType>Number</dataType>
                    <defaultValue>
                        <numberValue>0.0</numberValue>
                    </defaultValue>
                    <fieldText>Points Redeemed</fieldText>
                    <fieldType>InputField</fieldType>
                    <helpText>&lt;p&gt;Loyalty points the customer spent on this bill, as printed on the POS bill. 0 when none.&lt;/p&gt;</helpText>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                    <scale>0</scale>
                    <validationRule>
                        <errorMessage>&lt;p&gt;Points Redeemed must be a whole number of 0 or more, and not more than the bill after the voucher discount.&lt;/p&gt;</errorMessage>
                        <formulaExpression>AND({!Points_Redeemed_Input} &gt;= 0, {!Points_Redeemed_Input} = FLOOR({!Points_Redeemed_Input}), {!Points_Redeemed_Input} &lt;= {!Bill_Amount} - IF({!Voucher_Used_Input}, BLANKVALUE({!Voucher_Discount_Input}, 0), 0))</formulaExpression>
                    </validationRule>
                </fields>
                <fields>
                    <name>Voucher_Used_Input</name>
                    <dataType>Boolean</dataType>
                    <defaultValue>
                        <booleanValue>false</booleanValue>
                    </defaultValue>
                    <fieldText>A gift voucher was redeemed on this bill</fieldText>
                    <fieldType>InputField</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                </fields>
                <fields>
                    <name>Net_Amount_Text</name>
                    <fieldText>&lt;p&gt;&lt;span style="font-size: 11px; color: rgb(112, 110, 107);"&gt;NET AMOUNT - POINTS ARE EARNED ON THIS&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style="font-size: 16px;"&gt;{!Net_Amount_Preview}&lt;/strong&gt;&lt;/p&gt;</fieldText>
                    <fieldType>DisplayText</fieldType>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>6</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <fields>
                <name>Redemption_Section_Column2</name>
                <fieldType>Region</fieldType>
                <fields>
                    <name>Voucher_Code_Input</name>
                    <dataType>String</dataType>
                    <fieldText>Voucher Code</fieldText>
                    <fieldType>InputField</fieldType>
                    <helpText>&lt;p&gt;As printed on the POS bill. It must be an Active voucher of this customer.&lt;/p&gt;</helpText>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                    <validationRule>
                        <errorMessage>&lt;p&gt;Enter the Voucher Code.&lt;/p&gt;</errorMessage>
                        <formulaExpression>LEN(TRIM({!Voucher_Code_Input})) &gt; 0</formulaExpression>
                    </validationRule>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Voucher_Used_Input</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>true</booleanValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <fields>
                    <name>Voucher_Offer_Type_Input</name>
                    <choiceReferences>Voucher_Offer_Type_Choices</choiceReferences>
                    <dataType>String</dataType>
                    <fieldText>Voucher Offer Type</fieldText>
                    <fieldType>DropdownBox</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Voucher_Used_Input</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>true</booleanValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <fields>
                    <name>Voucher_Face_Value_Input</name>
                    <dataType>Currency</dataType>
                    <fieldText>Voucher Face Value</fieldText>
                    <fieldType>InputField</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                    <scale>2</scale>
                    <validationRule>
                        <errorMessage>&lt;p&gt;Voucher Face Value must be more than 0.&lt;/p&gt;</errorMessage>
                        <formulaExpression>{!Voucher_Face_Value_Input} &gt; 0</formulaExpression>
                    </validationRule>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Voucher_Used_Input</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>true</booleanValue>
                            </rightValue>
                        </conditions>
                        <conditions>
                            <leftValueReference>Voucher_Offer_Type_Input</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <stringValue>Fixed Price</stringValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <fields>
                    <name>Voucher_Percentage_Input</name>
                    <dataType>Number</dataType>
                    <fieldText>Voucher Discount Percentage</fieldText>
                    <fieldType>InputField</fieldType>
                    <helpText>&lt;p&gt;Percentage off, e.g. 10 for 10%.&lt;/p&gt;</helpText>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                    <scale>2</scale>
                    <validationRule>
                        <errorMessage>&lt;p&gt;Voucher Discount Percentage must be more than 0 and at most 100.&lt;/p&gt;</errorMessage>
                        <formulaExpression>AND({!Voucher_Percentage_Input} &gt; 0, {!Voucher_Percentage_Input} &lt;= 100)</formulaExpression>
                    </validationRule>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Voucher_Used_Input</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>true</booleanValue>
                            </rightValue>
                        </conditions>
                        <conditions>
                            <leftValueReference>Voucher_Offer_Type_Input</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <stringValue>Percentage</stringValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <fields>
                    <name>Voucher_Discount_Input</name>
                    <dataType>Currency</dataType>
                    <fieldText>Voucher Discount</fieldText>
                    <fieldType>InputField</fieldType>
                    <helpText>&lt;p&gt;Rupees the voucher took off the bill, as printed on the POS bill.&lt;/p&gt;</helpText>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                    <scale>2</scale>
                    <validationRule>
                        <errorMessage>&lt;p&gt;Voucher Discount must be more than 0 and not more than the bill Amount.&lt;/p&gt;</errorMessage>
                        <formulaExpression>AND({!Voucher_Discount_Input} &gt; 0, {!Voucher_Discount_Input} &lt;= {!Bill_Amount})</formulaExpression>
                    </validationRule>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Voucher_Used_Input</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>true</booleanValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <fields>
                    <name>Voucher_Channel_Input</name>
                    <choiceReferences>Voucher_Channel_Choices</choiceReferences>
                    <dataType>String</dataType>
                    <defaultValue>
                        <stringValue>POS</stringValue>
                    </defaultValue>
                    <fieldText>Voucher Redemption Channel</fieldText>
                    <fieldType>DropdownBox</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Voucher_Used_Input</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>true</booleanValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>6</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <isRequired>false</isRequired>
            <regionContainerType>SectionWithHeader</regionContainerType>
        </fields>
        <nextOrFinishButtonLabel>Save</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Success_Screen</name>
        <label>Transaction Saved</label>
        <locationX>176</locationX>
        <locationY>1322</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Success_Message</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 18px; color: rgb(46, 132, 74);&quot;&gt;✔ Transaction saved&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Transaction:&lt;/strong&gt; &lt;a href=&quot;/{!Saved_Transaction.Id}&quot; target=&quot;_blank&quot;&gt;{!Saved_Transaction.Name}&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Bill Amount:&lt;/strong&gt; ₹{!Saved_Transaction.Amount__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Voucher Discount:&lt;/strong&gt; ₹{!Saved_Transaction.Voucher_Discount__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Points Redeemed:&lt;/strong&gt; {!Saved_Transaction.Points_Redeemed__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Net Amount:&lt;/strong&gt; ₹{!Saved_Transaction.Net_Amount__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Bill_Details</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Always blank: clears a field on the bill.</description>
        <name>Blank_Number</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <description>Never assigned: used to clear text fields.</description>
        <name>Blank_Text</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The saved bill, read back for the success screen.</description>
        <name>Saved_Transaction</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Transaction_Record__c</objectType>
    </variables>
    <variables>
        <description>True after Bill Details was submitted without Bill Number or Transaction Date.</description>
        <name>Show_Missing_Details</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>The bill being entered: filled on Bill Details, redemption fields set after Redemptions, then created.</description>
        <name>Transaction_Record</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Transaction_Record__c</objectType>
    </variables>
</Flow>
