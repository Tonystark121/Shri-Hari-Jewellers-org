        <rules>
            <name>Fixed_Price_Voucher</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Voucher_Used_Input</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Voucher_Offer_Type_Input</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Fixed Price</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Fixed_Voucher</targetReference>
            </connector>
            <label>Fixed Price Voucher</label>
        </rules>
        <rules>
