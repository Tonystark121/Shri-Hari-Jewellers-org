    <description>Creates a Transaction Record (bill). Screen 1: bill details. Then the customer's gift vouchers that are valid for this bill are fetched (Active, not expired on the bill date, bill amount within the voucher's range). Screen 2: Redeem Points or Redeem Gift Voucher (only one); a voucher is picked from the list, then the Redemption Channel. On Save the bill is created; the trigger re-checks the voucher, applies the discount, redeems points and marks the voucher Redeemed. Launched from the New list button on Transaction Record.</description>
    <dynamicChoiceSets>
        <name>Redemption_Channel_Choices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Voucher_Redemption_Channel__c</picklistField>
        <picklistObject>Transaction_Record__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>Calendar date of the bill in India Standard Time (the org's time zone), to compare with voucher Expiry Dates. DATEVALUE on its own would use GMT.</description>
        <name>Bill_Date</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!Transaction_Record.Transaction_Date__c} + (5.5 / 24))</expression>
    </formulas>
    <formulas>
        <description>Preview only: same rule as GiftVoucherRedemption.discountFor (Fixed Price = Face Value, never more than the bill; Percentage = % of the total bill). The saved discount is calculated by Apex.</description>
        <name>Voucher_Discount_Preview</name>
        <dataType>Currency</dataType>
        <expression>IF(
  TEXT({!Voucher_Table.firstSelectedRow.Offer_Type__c}) = &quot;Fixed Price&quot;,
  MIN(BLANKVALUE({!Voucher_Table.firstSelectedRow.Face_Value__c}, 0), {!Bill_Amount}),
  ROUND({!Bill_Amount} * BLANKVALUE({!Voucher_Table.firstSelectedRow.Discount_Percentage__c}, 0) / 100, 2)
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Net_Amount_Preview</name>
        <dataType>Currency</dataType>
        <expression>MAX(0, {!Bill_Amount} - {!Voucher_Discount_Preview})</expression>
        <scale>2</scale>
    </formulas>
