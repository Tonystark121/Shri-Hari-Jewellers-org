                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bill_Details</targetReference>
            </connector>
            <label>Future Transaction Date</label>
        </rules>
    </decisions>
    <description>Creates a Transaction Record (bill). Screen 1: bill details. Then the customer's gift vouchers that are valid for this bill are fetched (Active, not expired on the bill date, bill amount within the voucher's range). Screen 2: Redeem Points or Redeem Gift Voucher (only one); a voucher is picked from the list, then the Redemption Channel. On Save the bill is created; the trigger re-checks the voucher, applies the discount, redeems points and marks the voucher Redeemed. Launched from the New list button on Transaction Record.</description>
    <dynamicChoiceSets>
        <name>Voucher_Channel_Choices</name>
        <dataType>Picklist</dataType>
        <picklistField>Voucher_Redemption_Channel__c</picklistField>
        <picklistObject>Transaction_Record__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>Voucher_Offer_Type_Choices</name>
        <dataType>Picklist</dataType>
        <picklistField>Voucher_Offer_Type__c</picklistField>
        <picklistObject>Transaction_Record__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>What the customer pays after the reported redemptions; Salesforce sets the same figure on the bill.</description>
        <name>Net_Amount_Preview</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!Bill_Amount}, 0) - IF({!Voucher_Used_Input}, BLANKVALUE({!Voucher_Discount_Input}, 0), 0) - BLANKVALUE({!Points_Redeemed_Input}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>True when the bill is dated after today. Same rule as the No_Future_Transaction_Date validation rule on Transaction Record, checked here so the user is told on the Bill Details screen instead of at save.</description>
        <name>Is_Future_Bill_Date</name>
        <dataType>Boolean</dataType>
        <expression>DATEVALUE({!Transaction_Record.Transaction_Date__c}) &gt; DATEVALUE({!$Flow.CurrentDateTime})</expression>
    </formulas>
    <interviewLabel>New Transaction {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Transaction</label>
