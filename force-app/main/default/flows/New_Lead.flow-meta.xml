    <description>New button on Lead. Captures the customer, then: an existing customer (same phone or email on an Account or Contact) gets an enquiry Case instead of a Lead; an open Lead with the same phone or email is reported as a duplicate; otherwise the Lead is created. Company defaults to &quot;&lt;Name&gt; - B2C&quot; (the system adds the Lead Number, e.g. Asha Mehta - B2C-000123); typing a company name makes the Lead B2B.</description>
    <environments>Default</environments>
    <formulas>
        <name>Full_Name</name>
        <dataType>String</dataType>
        <expression>TRIM(BLANKVALUE({!Lead_Record.FirstName}, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE({!Lead_Record.LastName}, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <description>&quot;&lt;Name&gt; - B2C&quot;, unless a company name was already typed (the user came back from Lead Details).</description>
        <name>Default_Company</name>
        <dataType>String</dataType>
        <expression>IF(
  OR(
    ISBLANK({!Lead_Record.Company}),
    UPPER(RIGHT(TRIM({!Lead_Record.Company}), 6)) = &quot; - B2C&quot;
  ),
  {!Full_Name} &amp; &quot; - B2C&quot;,
  {!Lead_Record.Company}
)</expression>
    </formulas>
    <formulas>
        <description>Same rule as LeadTriggerHandler: a blank or default Company means B2C.</description>
        <name>Business_Type_For_Company</name>
        <dataType>String</dataType>
        <expression>IF(
  OR(
    ISBLANK({!Lead_Record.Company}),
    UPPER(RIGHT(TRIM({!Lead_Record.Company}), 6)) = &quot; - B2C&quot;
  ),
  &quot;B2C&quot;,
  &quot;B2B&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Enquiry_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Enquiry from &quot; &amp; {!Full_Name}</expression>
    </formulas>
    <interviewLabel>New Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Lead</label>
