            <fieldText>&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="color: rgb(68, 68, 68);"&gt;&lt;strong&gt;{!Allot_Points.customersSkipped}&lt;/strong&gt; customer(s) got no points: their % of Last 12 Month Spend came to less than 10 points.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Allot_Points.customersSkipped</leftValueReference>
                    <operator>GreaterThan</operator>
