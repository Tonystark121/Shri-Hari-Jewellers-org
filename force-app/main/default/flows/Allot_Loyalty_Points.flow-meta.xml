    <description>Allot Points button on Loyalty Records: choose Fixed Points or a % of Last 12 Month Spend, filter and select customers, then enter the Expiry Date and Reason. Each customer gets a Bonus Loyalty Transaction (Source Manual) and their points balance goes up.</description>
    <environments>Default</environments>
    <formulas>
        <description>The points in words, for the success screen.</description>
        <name>Allotment_Summary</name>
        <dataType>String</dataType>
        <expression>IF({!Offer_Type} = "Percentage", {!Discount_Percentage} &amp; "% of Last 12 Month Spend", {!Offer_Amount} &amp; " points per customer")</expression>
    </formulas>
    <formulas>
        <description>The % as a number (the screen keeps it as text).</description>
        <name>Percentage_Value</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!Discount_Percentage}), 0, VALUE({!Discount_Percentage}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>The points as a number (the screen keeps them as text).</description>
        <name>Points_Value</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!Offer_Amount}), 0, VALUE({!Offer_Amount}))</expression>
        <scale>2</scale>
    </formulas>
