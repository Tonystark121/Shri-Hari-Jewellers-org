<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One record per Shopify order received through the Order API (POST /services/apexrest/shreehari/v1/orders). Every property of the Shopify order object is kept as sent, in a field named after the property; arrays and nested objects are stored as JSON text.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Staging Order</label>
    <nameField>
        <displayFormat>SO-{0}</displayFormat>
        <label>Staging Order Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Staging Orders</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Id__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Name__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Processing_Status__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>CREATED_DATE</customTabListAdditionalFields>
        <excludedStandardButtons>New</excludedStandardButtons>
        <lookupDialogsAdditionalFields>Id__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Name__c</lookupDialogsAdditionalFields>
        <searchResultsAdditionalFields>Id__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Name__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Processing_Status__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
