<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quantity_At_Least_One</fullName>
    <active>true</active>
    <description>Every line item is at least one piece.</description>
    <errorConditionFormula>OR(ISBLANK(Quantity__c), Quantity__c &lt; 1)</errorConditionFormula>
    <errorDisplayField>Quantity__c</errorDisplayField>
    <errorMessage>Quantity must be at least 1.</errorMessage>
</ValidationRule>
