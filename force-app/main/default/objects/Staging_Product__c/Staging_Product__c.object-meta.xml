<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One record per Shopify product received through the Product API (POST /services/apexrest/shreehari/v1/products). Every property of the Shopify product object is kept as sent; arrays and nested objects are stored as JSON text. Records are later processed into Product2.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Staging Product</label>
    <nameField>
        <displayFormat>SP-{0}</displayFormat>
        <label>Staging Product Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Staging Products</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Shopify_Id__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Title__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Processing_Status__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>CREATED_DATE</customTabListAdditionalFields>
        <excludedStandardButtons>New</excludedStandardButtons>
        <lookupDialogsAdditionalFields>Shopify_Id__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Title__c</lookupDialogsAdditionalFields>
        <searchResultsAdditionalFields>Shopify_Id__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Title__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Processing_Status__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
